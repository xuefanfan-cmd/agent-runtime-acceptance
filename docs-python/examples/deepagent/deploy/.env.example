# @section host
RUNTIME_HOST=127.0.0.1
RUNTIME_PORT=18092
DEEP_WORKSPACE=./data/deep-workspace

# @section model
# DeepAgent 在构造期校验模型端点：provider 为 openai 时 api_key 与 api_base 必填；
# LLM_VERIFY_SSL 为 true 时还要求 LLM_SSL_CERT。
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_BASE=
LLM_API_KEY=
LLM_VERIFY_SSL=true
LLM_SSL_CERT=

# @section runtime
# 本工程不从环境变量绑定 runtime 配置；`openjiuwen.service.*` 由
# resources/application.yml 经 ConfigLoader 装入。
