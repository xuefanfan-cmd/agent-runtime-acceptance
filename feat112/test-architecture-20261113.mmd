flowchart TB
  %% FEAT-112 测试仓代码架构（2026-11-13 现状）。实线=已实现；虚线框=洞察要求但未实现
  classDef gap stroke-dasharray:5 5,stroke:#b54708,color:#b54708,fill:#fffaf0
  classDef sut fill:#eef4ff,stroke:#3b5bdb
  classDef doc fill:#f6f6f6,stroke:#888
  classDef out fill:#effaf3,stroke:#2b8a3e

  subgraph DOC["① 契约与基线（docs，锚点）"]
    FEAT["特性档快照 05af9cc3<br/>（唯一预期来源）"]:::doc
    TP["testplan 镜像 a1db9d86<br/>+ 本地修订稿"]:::doc
    CASES["cases 文档<br/>（场景设计 / 实践反馈 / 运行登记）"]:::doc
    L2["DA L2 / ext L2<br/>（只作参考，不作预期）"]:::doc
  end

  subgraph GOV["② 治理层（FEAT-112）"]
    CONTRACT["Feat112Contract<br/>条款出处钉到特性档 05af9cc3"]
    COVER["Feat112Coverage<br/>解析 testplan ID；未承接 / 部分承接登记；生成 summary.md"]
    ARCH["Feat112ArchitectureTest（6 条结构规则，已做变异验证）<br/>层级=包 · ID 双向对账 · 只经 Finding 判定<br/>· 只引特性档 · 依赖方向 · 部署形态显式声明"]
  end

  subgraph CASE["③ 用例层（按验收层分目录）"]
    INT["cases/integration/task_degradation_gate<br/>13 个类 · PUBLIC_SURFACE（托管真实 DA 进程）"]
    COMP["cases/component/task_degradation_gate<br/>Feat112MechanismTest · COMPONENT（真实产品类）"]
  end

  subgraph RES["④ 通用结果层（判定与执行分离）"]
    SCEN["Scenario + @Covers(ID, 层)<br/>前置 / 激活 / 基础设施 三道关；check / accept"]
    EXT["AcceptanceExtension<br/>JUnit 状态由验收结论推导"]
    EVC["EvidenceChecks<br/>六态 · 原因码 · Rule / Finding / Observation"]
    VERD["ScenarioVerdict<br/>固定推导顺序：前置 / 激活 → 验收 → 中断 → 观察不到"]
    ID["ArtifactIdentity<br/>坐标 · 路径 · sha256 · 构建来源"]
    REP["AcceptanceReport<br/>逐场景汇总，含 NOT_EXECUTED"]
  end

  subgraph JUDGE["⑤ FEAT-112 判据（纯函数，不碰 SUT，各带自测含合法变体）"]
    JR["RejectionJudge（R：503 契约）"]
    JO["PrecedenceJudge（O：与门 CLOSED 对照）"]
    JS["SequenceJudge（W/X/N：窗口 / 状态 / 副作用）"]
    JD["DiagnosticJudge（G：诊断字段 / 不泄露）"]
    JG["GateSnapshotChecks / Expect"]
  end

  subgraph DRIVE["⑥ 驱动（只产出观察，不下结论）"]
    GD["GateDriver<br/>开门 / 建状态 / 带激活证明的注入 / 快照"]
    DEC["DaEvidenceClient<br/>HTTP / SSE，逐次交换落盘、脱敏"]
    STUBS["CorrelatedModelStub · SustainedModelStream<br/>SlowSseConsumer · OrderedControlRun"]
  end

  subgraph DEPLOY["⑦ 部署（形态由用例声明）"]
    FORM["DeploymentForm<br/>窗口 / 阈值 / 认证 / 白名单等"]
    GDEP["GateDeployment / DeployedGateCase<br/>经 SutStack 托管；缺部署记 infra_failure"]
    ISO["IsolatedDefaultProcess · SafeProcessCapture<br/>交付默认 / 非法配置 / 进程输出监听"]
    MSP["ModelStubProcess<br/>从载体 jar 拉起故障注入 stub"]
    ART["Feat112Artifacts<br/>按坐标解析载体并算 sha256"]
  end

  subgraph SUPPLY["⑧ 供给与执行"]
    YML["application-openjiuwen.yml<br/>sut.agents.feat112 / feat112-peer"]
    PROV["sut-sources.yml + provision-sut.sh<br/>构建并装入隔离 M2"]
    RUN["run-feat112.sh + RunSelected<br/>定向编译 / 运行 / 出报告（整仓编译受阻时的旁路）"]
    LIFE["SutStack / ProcessLauncher / MavenArtifact（仓库共享）"]
  end

  subgraph SUT["⑨ 被测物"]
    CAR["载体 jar degradation-agent-runtime<br/>DA 引擎 + ext 降级门 + core"]:::sut
    LFIS["LlmFaultInjectionStub（demo-common）"]:::sut
    PROD["产品类（feat112-product profile）"]:::sut
  end

  subgraph OUT["⑩ 产物"]
    EVJ["证据 JSON<br/>target/feat112-evidence/场景/NNN.json"]:::out
    RJ["结果 JSON（发现 / 期望 / 实际 / 证据引用 / 被测物身份）<br/>target/acceptance-results/runId/"]:::out
    SUM["summary.md（65 场景逐个结论）"]:::out
  end

  OFF["离线重评器：读已存证据 + 新版判据重算<br/>（D2 G2 / E2）"]:::gap
  VER["判据与测试仓版本、testplan 版本写入结果与报告头<br/>（D1 L3④ / D2 oracle_version）"]:::gap
  FP["期望文本指纹：testplan 前置 / 期望改动时代码必须复核<br/>（ID 绑定之外的语义绑定，2026-11-16 已实现）"]:::out
  CI["CI 门禁：结构规则与覆盖对账进流水线<br/>（D1 L5，现仅脚本运行）"]:::gap
  REPEAT["复跑器：时序 / 并发类场景 pass^k<br/>（D2 G4）"]:::gap
  PROV2["载体来源可追溯：core commit、demo/stub 纳入版本控制<br/>（D1 L4①）"]:::gap

  FEAT --> CONTRACT
  TP --> COVER
  CONTRACT --> JUDGE
  ARCH -. 校验 .-> CASE
  ARCH -. 校验 .-> JUDGE
  ARCH -. 校验 .-> TP
  INT --> SCEN
  COMP --> SCEN
  INT --> DRIVE
  INT --> DEPLOY
  COMP --> PROD
  SCEN --> JUDGE
  JUDGE --> EVC
  SCEN --> EXT --> VERD --> RJ
  ID --> RJ
  RJ --> REP --> SUM
  COVER --> SUM
  DRIVE --> CAR
  DRIVE --> LFIS
  DEC --> EVJ
  DEPLOY --> LIFE --> CAR
  MSP --> LFIS
  ART --> ID
  YML --> ART
  PROV --> CAR
  RUN --> CASE
  EVJ -.-> OFF
  RJ -.-> VER
  TP -.-> FP
  ARCH -.-> CI
  CASE -.-> REPEAT
  PROV -.-> PROV2
