ription":"当前系统时间","id":"currentTime","type":"string"},{"description":"使用该工作流的唯一标识","id":"userId","type":"string"},{"description":"工作流对话id","id":"conversationId","type":"string"},{"description":"会话轮次","id":"dialogueCount","type":"integer"}],"sourceType":"input","description":"系统变量","id":"sys","type":"object","required":true}],"outputs":[{"sourceType":"input","description":"user input","id":"query","type":"string","required":true},{"schema":[{"schema":{"schema":[{"description":"角色","id":"role","type":"string"},{"description":"消息内容","id":"content","type":"string"}],"id":"","type":"object"},"description":"会话历史消息","id":"conversationHistory","type":"array"},{"description":"当前系统时间","id":"currentTime","type":"string"},{"description":"使用该工作流的唯一标识","id":"userId","type":"string"},{"description":"工作流对话id","id":"conversationId","type":"string"},{"description":"会话轮次","id":"dialogueCount","type":"integer"}],"sourceType":"input","description":"系统变量","id":"sys","type":"object","required":true}]},"preDefinedFields":{"inputs":[{"schema":[],"sourceType":"null","description":null,"id":"memory","type":"object","required":true}],"outputs":[{"schema":[],"sourceType":"null","description":null,"id":"memory","type":"object","required":true}]}},"inputs":{"userFields":{"intents":[{"name":"","id":""}],"messages":[{"role":"","content":""}]},"memory":{},"systemFields":{"query":"","sys":{}}},"name":"开始","id":"node_start","type":"jiuwen.start"},{"outputs":{"userFields":{"intents_prompt":"","name_desc_list":[""],"allowed_function":[""],"parsed_list":"","history":[{"role":"","content":""}]}},"configs":{"userFields":{"inputs":[{"schema":{"schema":[{"description":"","id":"id","type":"string"},{"description":"","id":"name","type":"string"}],"id":"","type":"object"},"sourceType":"ref","description":"","id":"intents","type":"array","value":"${node_start.userFields.intents}","required":true},{"schema":{"schema":[{"description":"","id":"role","type":"string"},{"description":"","id":"content","type":"string"}],"id":"","type":"object"},"sourceType":"ref","description":"","id":"messages","type":"array","value":"${node_start.userFields.messages}","required":true}],"outputs":[{"schema":{"id":"","type":"string"},"sourceType":"null","description":"allowed_function","id":"allowed_function","type":"array","required":true},{"sourceType":"null","description":"parsed_list","id":"parsed_list","type":"string","required":true},{"schema":{"id":"","type":"string"},"sourceType":"null","description":"name_desc_list","id":"name_desc_list","type":"array","required":true},{"sourceType":"null","description":"intents_prompt","id":"intents_prompt","type":"string","required":true},{"schema":{"schema":[{"description":"角色","id":"role","type":"string"},{"description":"内容","id":"content","type":"string"}],"id":"","type":"object"},"sourceType":"null","description":"历史消息","id":"history","type":"array","required":true}]},"code":"import json\n\ndef main(args: dict) -> dict:\n    intents = args.get(\"intents\",[])\n    agent_history = args.get(\"messages\",[])\n    allowed_function = []\n    mapping = {}\n    history = [entry for entry in agent_history if entry[\"role\"]!=\"assistant\"]\n    for items in intents:\n        name = items.get(\"name\",\"\")\n        id = items.get(\"id\",\"\")\n        allowed_function.append(name)\n        try:\n            mapping[name] = int(id)\n        except:\n            mapping[name] = None \n    \n\n    return {\n        \"allowed_function\": allowed_function,\n        \"parsed_list\": json.dumps(mapping, ensure_ascii=False),\n        \"history\":history\n    }","template_version":"","fg_id":"","fg_urn":"","systemFields":{"inputs":[],"outputs":[]},"fg_url":"","enable_sandbox":false},"inputs":{"userFields":{"intents":"${node_start.userFields.intents}","messages":"${node_start.userFields.messages}"}},"name":"意图识别输入","id":"node_1760407976081","type":"jiuwen.code"},{"outputs":{"userFields":{"class":""}},"configs":{"vision":[],"userFields":{"inputs":[{"sourceType":"ref","description":"user input","id":"query","type":"string","value":"${node_start.systemFields.query}","required":false},{"schema":{"schema":[{"description":"角色","id":"role","type":"string"},{"description":"内容","id":"content","type":"string"}],"id":"","type":"object"},"sourceType":"ref","description":"","id":"history","type":"array","value":"${node_1760407976081.userFields.history}","required":true}],"outputs":[{"sourceType":"null","description":"分类结果","id":"class","type":"string","required":false}]},"memory":{"enable":false},"stream":true,"deployMode":"workflow","systemFields":{"inputs":[],"outputs":[]},"enableHistory":false,"templateContent":[{"content":"*角色定义**你是个智能管家助手，据备精准识别用户意图的能力，\n请根据用户与客服的对话历史及当前输入，从下列意图分类中选择最合适的分类。\n\n\n\n\n**当前可供选择的分类如下**\n\n\n\n\n-余额查询: 查询用户账户的当前实时余额信息。此意图聚焦于获取账户的即时资金状况，区别于查询历史交易记录的“查明细”意图。注意区分信用卡和信用卡还款卡，信卡的余额查询不属于此意图。典型用户表述包括“查看余额、“账户不有多少钱”等。\n\n\n\n\n-明细查询: 查询账户在特定时间段内的交易明细记录，包括收入、支出等详细流水。此意图用于追踪历史资金活动，与实时余额查询相区分。注意区分信用卡还款卡和信用卡，信用卡的还款记录查询不属于此意图。用户通常表述为查交易记录”、“看看最近消费明细”等。\n\n\n\n\n-贷款: 用户办理贷款类业务的意图，冰盖贷款申请、额度查询、支用操作、进度跟踪等全流程。包括消费贷、极速贷等产品，用户表达需涉及“申请贷款”、查询授信额度”、“贷款支用”等具体操作诉求。类似以下的表述不属于此意图:“信用卡还款”、“贷记卡还款”、信用卡分期”、悦享分期”。\n\n\n\n\n-理财: 用户办理理财产品(含基金、贵金属)的购买、推荐、持仓查询等业务。此意图包括风险测评结果查询、合格投资者状态查询、基于用户风险测评结果的理财产品主动推荐，或查询现有理财持仓状态，注意区分理财产品推荐与活动推荐。注意基金业务归属此类，但需区分用户寻求基金推荐与一般理财推荐。\n\n\n\n\n-转账: 户进行转账操作的意图，包括发起转账、提供或修改收款/付款信息(如卡号、金额)、确认或取消转专账等坏节，注意与缴费、还款意图区分。支持行内及跨行人民币转账，不包含下述业务：外币业务、境外转账。典型表述如“我要转账”、“修改收款账号”等。类似以下的表述不属于此意图：“设置复制账户转专账？、\"免登录转账”、“扫码支付”、“绑卡支付”。\n\n\n\n\n-其他: 除上述分类外其他均属于其他类。\n\n\n\n\n**要求**\n\n根据当前榆入和对话历史分析并输出最适合的功能分类\n\n\n\n\n**输出格式**\n\n\n\n\n输出格式为JSON，包含以下字段:\nclass: 代表分类结果\n\n如果没有合适的分类，请输出{“class\":\"其他”}\n\n\n\n\n只需输出JSON的分类结果，无需输出任何其他信息。\n\n\n\n\n**对话历史和用户输入**\n\n\n\n\n对话历史：{{history}}\n\n\n\n\n用户输入{{query}}\n\n","role":"user"}],"responseFormat":{"type":"text"},"model":{"modelName":"1788a9e4-c729-40db-8dd8-7cc20b3e6b7d","extension":{"safetyBarrier":false,"deploymentId":"1788a9e4-c729-40db-8dd8-7cc20b3e6b7d","authId":"efc1d837-4f79-4e3a-8d03-62f23d87f73b"},"hyperParameters":{"top_p":0.5,"frequency_penalty":0,"max_tokens":2048,"temperature":0.5},"modelType":"LLM"},"historySize":20},"inputs":{"userFields":{"query":"${node_start.systemFields.query}","history":"${node_1760407976081.userFields.history}"}},"name":"意图识别","id":"node_llm","type":"jiuwen.LLMComponent"},{"outputs":{"userFields":{"intent_id":"${node_1760427149412.userFields.intent_id}"},"responseContent":""},"configs":{"responseMode":"directResponse","userFields":{"inputs":[],"outputs":[{"sourceType":"ref","description":"","id":"intent_id","type":"integer","value":"${node_1760427149412.userFields.intent_id}","required":true}]},"responseTemplate":"","systemFields":{"inputs":[],"outputs":[]},"isStreamOut":true,"enable_history":true,"isStructMessage":false},"inputs":{"userFields":{}},"name":"结束","id":"node_end","type":"jiuwen.end"},{"outputs":{"userFields":{"intent_id":""}},"configs":{"userFields":{"inputs":[{"sourceType":"ref","description":"","id":"intention","type":"string","value":"${node_llm.userFields.class}","required":true}],"outputs":[{"sourceType":"null","description":"意图分类","id":"intent_id","type":"integer","required":true}]},"code":"import json\n\n\ndef main(args: dict) -> dict:\n    \"\"\"\n    运行代码节点会调用此函数\n    :param args: 输入固定为args字典类型，KV为输入参数键值对\n    :return: 输出参数为字典类型，kv为输出参数键值对\n    \"\"\"\n    intention_class = args.get('intention')\n    result = intention_class.replace('```json', '').replace('```', '')\n    intention = json.loads(result)\n\n    intention = intention.get('class')\n\n    class_mapping = {\n        \"其他\": \"1\",\n        \"理财\": \"2\",\n        \"贷款\": \"3\",\n    }\n    \n    intent_id=class_mapping.get(intention)\n\n    ret = {\"intent_id\": intent_id}\n    return ret","template_version":"","exec_env":"local","fg_id":"","fg_urn":"","systemFields":{"inputs":[],"outputs":[]},"fg_url":"","enable_sandbox":false},"inputs":{"userFields":{"intention":"${node_llm.userFields.class}"}},"name":"意图识别结果","id":"node_1760427149412","type":"jiuwen.code"}],"metadata":{"visibility":"project","publishedAt":1789891842205,"type":"task","userId":"testUser","projectId":"0","domainId":"0","workspaceId":"821ffba2e1a340eda903f3d36302277b","updatedAt":1789891915672,"status":"published"},"schemaVersion":"0.6.0","description":"主控制器意图识别工作流","workflowName":"maincontroller","workflowVersion":"0.6.0","workflowId":"62e729c3-70b3-42eb-a47b-d35bfa7e75ce","connections":[{"source":{"componentId":"node_start"},"target":{"componentId":"node_1760407976081"}},{"source":{"componentId":"node_1760427149412"},"target":{"componentId":"node_end"}},{"source":{"componentId":"node_1760407976081"},"target":{"componentId":"node_llm"}},{"source":{"componentId":"node_llm"},"target":{"componentId":"node_1760427149412"}}]}