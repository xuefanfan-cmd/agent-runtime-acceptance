<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.7</version>
        <relativePath/>
    </parent>

    <groupId>com.openjiuwen.example</groupId>
    <artifactId>studio-dsl-demo</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <name>studio-dsl-demo</name>
    <description>SUT Agent for FEAT-031 Studio DSL node type extension acceptance testing</description>

    <properties>
        <java.version>21</java.version>
        <agent-runtime-java.version>0.1.2</agent-runtime-java.version>
        <agent-core-ext-studio-dsl.version>0.1.1</agent-core-ext-studio-dsl.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <slf4j.version>2.0.12</slf4j.version>
        <logback.version>1.5.37</logback.version>
        <snakeyaml.version>2.2</snakeyaml.version>
        <byte-buddy.version>1.15.11</byte-buddy.version>
        <commons-lang3.version>3.18.0</commons-lang3.version>
        <commons-codec.version>1.20.0</commons-codec.version>
        <lombok.version>1.18.32</lombok.version>
        <gson.version>2.11.0</gson.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.openjiuwen</groupId>
                <artifactId>agent-runtime-java</artifactId>
                <version>${agent-runtime-java.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.openjiuwen</groupId>
                <artifactId>agent-service-app</artifactId>
                <version>${agent-runtime-java.version}</version>
            </dependency>
            <dependency>
                <groupId>com.openjiuwen</groupId>
                <artifactId>agent-service-adapters-agentcore</artifactId>
                <version>${agent-runtime-java.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>com.openjiuwen</groupId>
            <artifactId>agent-service-app</artifactId>
        </dependency>
        <dependency>
            <groupId>com.openjiuwen</groupId>
            <artifactId>agent-service-adapters-agentcore</artifactId>
        </dependency>
        <dependency>
            <groupId>com.openjiuwen</groupId>
            <artifactId>agent-core-ext-studio-dsl</artifactId>
            <version>${agent-core-ext-studio-dsl.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.openjiuwen.example.studiodsl.StudioDslDemoApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
