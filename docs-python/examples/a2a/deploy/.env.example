# @section host
# 宿主命名空间：本工程源码实际读取的 RUNTIME_* 旋钮
RUNTIME_AGENT_DESCRIPTION=standard-a2a-fixture-agent
RUNTIME_AGENT_NAME=a2a-fixture-agent
RUNTIME_AGENT_VERSION=1.0.0
RUNTIME_FIXTURE_DELAY_S=0
RUNTIME_HOST=127.0.0.1
RUNTIME_PORT=8090
RUNTIME_TASK_STORE=memory
#RUNTIME_SELF_URL=http://127.0.0.1:8090/a2a/

# @section runtime
# 本工程不从环境变量读 runtime 配置；没有调用 ConfigLoader 绑定 OPENJIUWEN__SERVICE__*。
