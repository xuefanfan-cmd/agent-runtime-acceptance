# FEAT-112 expectation sources. The test repo stores no copy of requirement or testplan text;
# scripts/fetch-expectations.sh fetches the testplan from the docs repository.
# Within a version cycle the tests follow the latest testplan on FEAT112_TESTPLAN_BRANCH. After a version is
# released, its testplan commit is archived with that version and set here (or as FEAT112_TESTPLAN_COMMIT in the
# environment) only to reproduce that version's run.
# Shell-sourceable KEY="value" lines only.

DOCS_REPO_URL="https://gitcode.com/Technical-AF/docs.git"

FEAT112_TESTPLAN_PATH="develop/04-testplan/FEAT-112-task-degradation-gate-testplan.md"
FEAT112_TESTPLAN_BRANCH="main"
# Empty within a version cycle (follow the latest); an archived commit only for a released version.
FEAT112_TESTPLAN_COMMIT=""
