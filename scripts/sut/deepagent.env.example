# deepagent.env.example — deepagent 链路（deep-research/search/verify 三 jar）本地运行变量模板（不含真实密钥，可入库）
#
# 用法：
#   cp scripts/sut/deepagent.env.example .env.local     # .env.local 已在 .gitignore 中，永不入库
#   # 填入真实值后
#   ./scripts/sut/run-deepagent-local.sh -Dgroups=feat-001
#
# 原理：框架用 ProcessBuilder 启动 agent jar，**继承父进程环境变量**
# （ProcessLauncher 只在继承的环境上做叠加，不 clear），而三个 jar 的 application.yml
# 里全部写成 ${VAR} 占位符。所以密钥走环境变量注入即可，无需落进任何被 git 跟踪的 YAML。
# application-local.yml 的注释也明确要求走这条路径而不是 sut.java.system-properties。

# ── LLM（三个 agent 共用；jar 内 application.yml 读的是 ${LLM_API_KEY} 等）──
# provider 固定 OpenAI（走 OpenAI 兼容协议，DeepSeek 即用此协议）
LLM_PROVIDER=OpenAI
LLM_API_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro
LLM_API_KEY=sk-REPLACE_ME

# ── search agent 的联网检索 ──
# 缺省为空串（jar 内写法 ${TAVILY_API_KEY:}），置空则联网检索不可用。
# 若只想跑不依赖外网的用例，可改用 SEARCH_AGENT_USE_STUB=true / profile=stub。
TAVILY_API_KEY=tvly-REPLACE_ME

# ── FEAT-001 push notification 开关（决定 Agent Card capabilities 与 receiver 表面）──
# 注意变量名是**复数 S**：DEEP_RESEARCH_PUSH_NOTIFICATIONS，写成单数不生效（jar 内默认 false）。
DEEP_RESEARCH_PUSH_NOTIFICATIONS=true
# search agent 的 a2a 段**根本没有声明 push-notifications**，运行时恒为 false，
# 因此「search 配 false」无需任何变量，保持不设即可（设了也不会被读）。

# deep-research 对外自述地址；D 组 callback 用例依赖它拼 receiver URL。
# managed 模式下端口由框架分配，一般不要写死；仅在手工 java -jar 时才需要。
# DEEP_RESEARCH_PUBLIC_URL=http://127.0.0.1:18090

# sender 侧发 callback 时带的凭据（属 openjiuwen.demo.deep-research.callback-auth）。
# 注意：receiver 侧鉴权是 callback-auth profile 门控（激活 profile + 本 token 才生效；只设 token 不激活 profile 入口不拦截）。
# DEEP_RESEARCH_CALLBACK_TOKEN=local-callback-token

# ── 可选：Maven 本地仓不在 ~/.m2/repository 时 ──
# SUT_M2_REPO=D:/repository
