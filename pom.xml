    <build>
        <plugins>
            <!-- Surefire — JUnit 5 engine -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Default: run only component + integration (skip e2e / performance) -->
                    <excludedGroups>e2e,performance</excludedGroups>
                    <!-- FEAT-065/066：把被测源码根透传给静态合同用例（见 <properties> 说明） -->
                    <systemPropertyVariables>
                        <orchestration.source.root>${orchestration.source.root}</orchestration.source.root>
                        <deepanalyze.source.root>${deepanalyze.source.root}</deepanalyze.source.root>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <!-- Failsafe — for e2e and performance suites (IT.*) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <groups>e2e</groups>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Compiler — Java 21 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <compilerArgs>
                        <arg>--enable-preview</arg>
                    </compilerArgs>
                    <!-- 2026-08-28 临时排除：M2 里 com.openjiuwen:agent-client-sdk-for-jvm:0.1.0
                         jar 是空的（324 字节，只含 MANIFEST），com.openjiuwen.client.api.* 类无提供者。
                         排除全部 13 个依赖该 SDK 的 test 源码（agent_bus 全目录 + deepagent 3 个 + react_travel 4 个），
                         让其他 45+ 个用例可编译可跑；SDK 修好后可移除本段。
                         2026-09-16：agent-client-sdk-for-jvm:0.1.1（150 files/128 classes）已可用，
                         **/agent_bus/** 整目录排除收窄为下列 5 个仍引用旧版 RDC/SDK 内部 API 的陈旧
                         白盒/契约用例，其余 agent_bus 用例（含 FEAT-011/012/013/014 黑盒）恢复编译。 -->
                    <testExcludes>
                        <exclude>**/agent_bus/ClientGatewayBusA2aRouteEndToEndIT.java</exclude>
                        <exclude>**/agent_bus/ClientToolRuntimeBlackboxTest.java</exclude>
                        <exclude>**/agent_bus/LocalToolBlackboxTest.java</exclude>
                        <exclude>**/agent_bus/RegistryRouteQueryContractTest.java</exclude>
                        <exclude>**/agent_bus/StandardAgentClientBlackboxTest.java</exclude>
                        <exclude>**/deepagent_deepresearch/MultiHopCallTreeBlackboxTest.java</exclude>
                        <exclude>**/deepagent_deepresearch/RuntimeProducerCallTreeFixture.java</exclude>
                        <exclude>**/deepagent_deepresearch/SkillHubDeepAgentBlackboxTest.java</exclude>
                        <exclude>**/react_travel/CustomRestReactAgentBlackboxTest.java</exclude>
                        <exclude>**/react_travel/RedisClusterAndSwitchTest.java</exclude>
                        <exclude>**/react_travel/RedisConfigurationAndDiagnosticsTest.java</exclude>
                        <exclude>**/react_travel/RedisStandaloneBehaviorTest.java</exclude>
                        <exclude>**/e2e/reconnect/**</exclude>
                        <exclude>**/fixtures/reconnect/**</exclude>
                        <!-- 2026-10-29 临时排除（FEAT-033 unblock）：下列两目录测试源码 import
                             com.openjiuwen.agents.orchestration.* 包，依赖 agent-core-ext-orchestration
                             artifact；该 artifact 在 ECS ~/.m2 下未成功下载过，本仓 pom 已临时注释
                             orchestration + deepanalyze-engine 两条 dep（见上方 dependencies 段）。
                             队友上传 jar+pom 后恢复 dep + 删本两条 exclude。 -->
                        <exclude>**/component/deepanalyze_template/**</exclude>
                        <exclude>**/e2e/deepanalyze/**</exclude>
                    </testExcludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!-- Profile-activated: `./mvnw allure:report -Pallure-report` (or `allure:serve`).
         Kept inside a profile so the plugin's auto-download of Node.js + the Allure 3
         binary is NEVER triggered during normal builds (mvn test / verify / install).
         run-pipeline.sh Stage 4 uses `allure generate` from the locally-installed CLI
         instead — see the nvm-loading guard there. -->
    <profiles>
        <profile>
            <id>allure-report</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>io.qameta.allure</groupId>
                        <artifactId>allure-maven</artifactId>
                        <version>3.0.2</version>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- FEAT-032 f03223 headless 显式失败语义：桌面会话（非 headless）JVM 下该用例按
             dependency-gated SKIPPED；用本 profile 以 headless 分叉 JVM 单独激活：
             mvn test -Pheadless-gate -Dtest=Feat032SutToolDirectTest#f03223HeadlessScreenshotFailsExplicitly
             （与 F032-22 桌面正向语义互斥环境分别执行，见测试设计文档附录 A） -->
        <profile>
            <id>headless-gate</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
