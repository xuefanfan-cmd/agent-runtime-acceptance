# @section host
# 宿主命名空间：本工程源码实际读取的旋钮（runtime/configuration.py 的 HostConfig）
RUNTIME_HOST=127.0.0.1
RUNTIME_PORT=18091

# @section model
# 模型后端。装配与本工程测试不需要它们；真实对话（how-to 的端到端校验）才需要。
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_BASE=
LLM_API_KEY=

# @section runtime
# 本工程不从环境变量绑定 runtime 配置；`openjiuwen.service.*` 由
# resources/application.yml 经 ConfigLoader 装入。
