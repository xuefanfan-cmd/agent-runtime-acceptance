# @section host
RUNTIME_HOST=127.0.0.1
RUNTIME_PORT=18090

# @section model
# 工作流的 LLM 节点与 HITL 追问节点都需要模型；装配与本工程测试不需要。
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_BASE=
LLM_API_KEY=

# @section runtime
# 本工程不从环境变量绑定 runtime 配置；`openjiuwen.service.*` 由
# resources/application.yml 经 ConfigLoader 装入。
